PORT=4000
NODE_ENV=development

# MongoDB connection string. Must be a replica set (MongoDB Atlas is one):
# bookings use transactions so two guests can't take the last room at once.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quickstay?retryWrites=true&w=majority

# Required in production: at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Required in production. Comma-separated frontend origins allowed to call the API,
# no trailing slash. "*" is allowed for previews: https://hotel-booking-*.vercel.app
CLIENT_URL=http://localhost:5173
# Public URL of the frontend (used in emails and Stripe redirects).
APP_URL=http://localhost:5173

# Tax rate applied to bookings (0.1 = 10%).
TAX_RATE=0.1
# Seed demo hotels and demo accounts, only into a completely empty database.
# Defaults to true locally and false in production unless set to true.
SEED_ON_EMPTY=true

# Optional: card payments via Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: transactional email (booking confirmations, password resets).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuickStay <no-reply@yourdomain.com>
