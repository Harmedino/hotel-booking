PORT=4000
NODE_ENV=development

# PostgreSQL connection string. Neon / Supabase free tiers work well.
DATABASE_URL=postgres://quickstay:quickstay@localhost:5432/quickstay
# Set to true for hosts whose certificate chain Node doesn't trust (e.g. Render Postgres).
DATABASE_SSL=false

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins. Leave empty to allow all.
CLIENT_URL=http://localhost:5173
# Public URL of the frontend (used in emails and Stripe redirects).
APP_URL=http://localhost:5173

# Tax rate applied to bookings (0.1 = 10%).
TAX_RATE=0.1
# Seed demo hotels and accounts when the database is empty.
SEED_ON_EMPTY=true

# Optional: card payments via Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: transactional email (booking confirmations, password resets).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuickStay <no-reply@yourdomain.com>
